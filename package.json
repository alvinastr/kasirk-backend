{
  "name": "kasirk-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint src/ test/",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./jest.config.cjs",
    "test:unit": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./jest.config.cjs",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./jest.config.cjs --watch",
    "test:cov": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./jest.config.cjs --coverage",
    "test:debug": "node --experimental-vm-modules --inspect-brk ./node_modules/jest/bin/jest.js --config ./jest.config.cjs --runInBand",
    "test:integration": "node test/run-integration.cjs",
    "test:all": "npm run test:unit -- --runInBand && npm run test:e2e -- --runInBand && npm run test:integration",
    "verify": "npm run lint && npm run build && npm run test:all",
    "test:hardening": "TS_NODE_PROJECT=test/tsconfig.hardening.json node --require ts-node/register/transpile-only --test test/hardening.integration.ts",
    "test:rbac": "TS_NODE_PROJECT=test/tsconfig.hardening.json node --require ts-node/register/transpile-only --test test/rbac.integration.cjs",
    "test:reports": "TS_NODE_PROJECT=test/tsconfig.hardening.json node --require ts-node/register/transpile-only --test test/reports.integration.cjs",
    "test:customers": "TS_NODE_PROJECT=test/tsconfig.hardening.json node --env-file=.env --require ts-node/register/transpile-only --test test/customers.integration.cjs",
    "test:receipts": "TS_NODE_PROJECT=test/tsconfig.hardening.json node --env-file=.env --require ts-node/register/transpile-only --test test/receipts.integration.cjs",
    "test:shifts": "TS_NODE_PROJECT=test/tsconfig.hardening.json node --env-file=.env --require ts-node/register/transpile-only --test test/shifts.integration.cjs",
    "test:sync": "TS_NODE_PROJECT=test/tsconfig.hardening.json node --env-file=.env --require ts-node/register/transpile-only --test test/sync.integration.cjs",
    "test:optional-stock": "TS_NODE_PROJECT=test/tsconfig.hardening.json node --env-file=.env --require ts-node/register/transpile-only --test test/optional-stock.integration.cjs",
    "test:product-category": "TS_NODE_PROJECT=test/tsconfig.hardening.json node --env-file=.env --require ts-node/register/transpile-only --test test/product-category.integration.cjs",
    "test:auth": "TS_NODE_PROJECT=test/tsconfig.hardening.json node --env-file=.env --require ts-node/register/transpile-only --test test/auth.integration.cjs",
    "test:user-pin": "TS_NODE_PROJECT=test/tsconfig.hardening.json node --env-file=.env --require ts-node/register/transpile-only --test test/user-pin.integration.cjs",
    "test:pin-login": "TS_NODE_PROJECT=test/tsconfig.hardening.json node --env-file=.env --require ts-node/register/transpile-only --test test/pin-login.integration.cjs",
    "test:device-session": "TS_NODE_PROJECT=test/tsconfig.hardening.json node --env-file=.env --require ts-node/register/transpile-only --test test/device-session.integration.cjs",
    "test:e2e": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./test/jest-e2e.json",
    "postinstall": "prisma skills sync || exit 0"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/observe": "^0.1.8",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.0.0",
    "jest": "^29.7.0",
    "jest-util": "^29.7.0",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "prisma": "^7.10.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.2"
  }
}
