generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model categories {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id  String     @db.Uuid
  name       String     @db.VarChar(100)
  created_at DateTime   @default(now()) @db.Timestamptz(6)
  tenants    tenants    @relation(fields: [tenant_id], references: [id], onUpdate: NoAction, map: "fk_categories_tenant")
  products   products[]

  @@unique([tenant_id, name], map: "uq_categories_tenant_name")
  @@index([tenant_id], map: "idx_categories_tenant_id")
}

model customers {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id    String         @db.Uuid
  name         String         @db.VarChar(150)
  phone        String?        @db.VarChar(30)
  email        String?        @db.VarChar(255)
  created_at   DateTime       @default(now()) @db.Timestamptz(6)
  updated_at   DateTime       @default(now()) @updatedAt @db.Timestamptz(6)
  tenants      tenants        @relation(fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_customers_tenant")
  transactions transactions[]

  @@unique([tenant_id, phone], map: "uq_customers_tenant_phone")
  @@unique([id, tenant_id], map: "uq_customers_id_tenant")
  @@index([tenant_id], map: "idx_customers_tenant_id")
}

/// This table contains check constraints and a partial unique index that Prisma cannot represent directly.
/// V1-M1: opening_cash is now nullable for non-reconciling shifts. Legacy rows retain their values.
model cashier_sessions {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id     String         @db.Uuid
  outlet_id     String         @db.Uuid
  user_id       String         @db.Uuid
  opening_cash  BigInt?
  closing_cash  BigInt?
  expected_cash BigInt?
  difference    BigInt?
  status        String         @default("OPEN") @db.VarChar(20)
  opened_at     DateTime       @default(now()) @db.Timestamptz(6)
  closed_at     DateTime?      @db.Timestamptz(6)
  outlets       outlets        @relation(fields: [outlet_id, tenant_id], references: [id, tenant_id], onDelete: Restrict, onUpdate: NoAction, map: "fk_cashier_sessions_outlet_same_tenant")
  tenants       tenants        @relation(fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_cashier_sessions_tenant")
  users         users          @relation(fields: [user_id, tenant_id], references: [id, tenant_id], onDelete: Restrict, onUpdate: NoAction, map: "fk_cashier_sessions_user_same_tenant")
  transactions  transactions[]
  held_orders   held_orders[]

  @@unique([id, tenant_id], map: "uq_cashier_sessions_id_tenant")
  @@index([tenant_id], map: "idx_cashier_sessions_tenant_id")
  @@index([tenant_id, user_id, status], map: "idx_cashier_sessions_tenant_user_status")
  @@index([tenant_id, outlet_id, opened_at], map: "idx_cashier_sessions_tenant_outlet_opened_at")
}

/// Authentication sessions are separate from operational cashier shifts.
/// This table contains a status check constraint that Prisma cannot represent directly.
model device_sessions {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id          String            @db.Uuid
  user_id            String            @db.Uuid
  device_id          String            @db.Uuid
  device_name        String?           @db.VarChar(100)
  refresh_token_hash String            @unique(map: "uq_device_sessions_refresh_token_hash")
  status             String            @default("ACTIVE") @db.VarChar(20)
  created_at         DateTime          @default(now()) @db.Timestamptz(6)
  last_used_at       DateTime          @default(now()) @db.Timestamptz(6)
  expires_at         DateTime          @db.Timestamptz(6)
  rotated_at         DateTime?         @db.Timestamptz(6)
  revoked_at         DateTime?         @db.Timestamptz(6)
  tenants            tenants           @relation(fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_device_sessions_tenant")
  users              users             @relation(fields: [user_id, tenant_id], references: [id, tenant_id], onDelete: Restrict, onUpdate: NoAction, map: "fk_device_sessions_user_same_tenant")
  auth_audit_logs    auth_audit_logs[]

  @@unique([id, tenant_id], map: "uq_device_sessions_id_tenant")
  @@index([tenant_id, user_id, status], map: "idx_device_sessions_tenant_user_status")
  @@index([tenant_id, user_id, device_id], map: "idx_device_sessions_tenant_user_device")
  @@index([expires_at], map: "idx_device_sessions_expires_at")
}

model auth_audit_logs {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id       String           @db.Uuid
  user_id         String?          @db.Uuid
  session_id      String?          @db.Uuid
  event           String           @db.VarChar(100)
  result          String           @db.VarChar(30)
  metadata        Json?            @db.JsonB
  created_at      DateTime         @default(now()) @db.Timestamptz(6)
  tenants         tenants          @relation(fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_auth_audit_logs_tenant")
  users           users?           @relation(fields: [user_id, tenant_id], references: [id, tenant_id], onDelete: Restrict, onUpdate: NoAction, map: "fk_auth_audit_logs_user_same_tenant")
  device_sessions device_sessions? @relation(fields: [session_id, tenant_id], references: [id, tenant_id], onDelete: Restrict, onUpdate: NoAction, map: "fk_auth_audit_logs_session_same_tenant")

  @@index([tenant_id, created_at], map: "idx_auth_audit_logs_tenant_created_at")
  @@index([tenant_id, user_id, created_at], map: "idx_auth_audit_logs_tenant_user_created_at")
  @@index([tenant_id, session_id], map: "idx_auth_audit_logs_tenant_session")
  @@index([tenant_id, event, created_at], map: "idx_auth_audit_logs_tenant_event_created_at")
}

model outlets {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id         String              @db.Uuid
  name              String              @db.VarChar(100)
  address           String?
  is_active         Boolean             @default(true)
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  tenants           tenants             @relation(fields: [tenant_id], references: [id], onUpdate: NoAction, map: "fk_outlets_tenant")
  product_stocks    product_stocks[]
  stock_adjustments stock_adjustments[]
  stock_movements   stock_movements[]
  transactions      transactions[]
  users             users[]
  cashier_sessions  cashier_sessions[]
  held_orders       held_orders[]

  @@unique([id, tenant_id], map: "uq_outlets_id_tenant")
  @@index([tenant_id], map: "idx_outlets_tenant_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// V1-M1: added nullable amount_received and change_amount for CASH semantics.
/// Legacy rows remain valid with both fields NULL. Payment.amount semantics
/// are unchanged (settled transaction amount).
model payments {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id          String       @db.Uuid
  transaction_id     String       @db.Uuid
  method             String       @db.VarChar(20)
  status             String       @default("PENDING") @db.VarChar(20)
  amount             BigInt
  amount_received    BigInt?
  change_amount      BigInt?
  provider           String?      @db.VarChar(50)
  provider_reference String?      @db.VarChar(255)
  paid_at            DateTime?    @db.Timestamptz(6)
  created_at         DateTime     @default(now()) @db.Timestamptz(6)
  updated_at         DateTime     @default(now()) @updatedAt @db.Timestamptz(6)
  transactions       transactions @relation(fields: [transaction_id, tenant_id], references: [id, tenant_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_payments_transaction_same_tenant")
  tenants            tenants      @relation(fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_payments_tenant")

  @@index([transaction_id], map: "idx_payments_transaction_id")
  @@index([tenant_id, status], map: "idx_payments_tenant_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model product_stocks {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outlet_id  String   @db.Uuid
  product_id String   @db.Uuid
  stock      Int      @default(0)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  outlets    outlets  @relation(fields: [outlet_id], references: [id], onUpdate: NoAction, map: "fk_product_stocks_outlet")
  products   products @relation(fields: [product_id], references: [id], onUpdate: NoAction, map: "fk_product_stocks_product")

  @@unique([outlet_id, product_id], map: "uq_product_stocks_outlet_product")
  @@index([product_id], map: "idx_product_stocks_product_id")
}

/// V1-M1: tenant-owned reusable modifier group. Selection rules live on the
/// product association, not the group. Contains a CHECK constraint for the
/// selection type that Prisma cannot represent directly.
model modifier_groups {
  id             String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id      String                    @db.Uuid
  name           String                    @db.VarChar(150)
  is_active      Boolean                   @default(true)
  display_order  Int                       @default(0)
  created_at     DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime                  @default(now()) @updatedAt @db.Timestamptz(6)
  tenants        tenants                   @relation(fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_modifier_groups_tenant")
  options        modifier_options[]
  product_groups product_modifier_groups[]

  @@unique([tenant_id, name], map: "uq_modifier_groups_tenant_name")
  @@unique([id, tenant_id], map: "uq_modifier_groups_id_tenant")
  @@index([tenant_id], map: "idx_modifier_groups_tenant_id")
}

/// V1-M1: tenant-owned modifier option. price_delta is integer Rupiah and must
/// be non-negative (CHECK constraint added in the migration).
model modifier_options {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id         String          @db.Uuid
  modifier_group_id String          @db.Uuid
  name              String          @db.VarChar(150)
  price_delta       Int
  is_active         Boolean         @default(true)
  display_order     Int             @default(0)
  created_at        DateTime        @default(now()) @db.Timestamptz(6)
  updated_at        DateTime        @default(now()) @updatedAt @db.Timestamptz(6)
  modifier_groups   modifier_groups @relation(fields: [modifier_group_id, tenant_id], references: [id, tenant_id], onDelete: Restrict, onUpdate: NoAction, map: "fk_modifier_options_modifier_group_same_tenant")
  tenants           tenants         @relation(fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_modifier_options_tenant")

  @@unique([tenant_id, modifier_group_id, name], map: "uq_modifier_options_tenant_group_name")
  @@index([tenant_id], map: "idx_modifier_options_tenant_id")
  @@index([modifier_group_id, tenant_id], map: "idx_modifier_options_group_tenant")
}

/// V1-M1: explicit Product <-> ModifierGroup association carrying product-specific
/// selection rules. Composite tenant-safe foreign keys prevent cross-tenant links.
/// Contains a CHECK constraint for selection_type that Prisma cannot represent directly.
model product_modifier_groups {
  tenant_id         String          @db.Uuid
  product_id        String          @db.Uuid
  modifier_group_id String          @db.Uuid
  required          Boolean         @default(false)
  selection_type    String          @db.VarChar(20)
  display_order     Int             @default(0)
  created_at        DateTime        @default(now()) @db.Timestamptz(6)
  updated_at        DateTime        @default(now()) @updatedAt @db.Timestamptz(6)
  modifier_groups   modifier_groups @relation(fields: [modifier_group_id, tenant_id], references: [id, tenant_id], onDelete: Restrict, onUpdate: NoAction, map: "fk_product_modifier_groups_group_same_tenant")
  products          products        @relation(fields: [product_id, tenant_id], references: [id, tenant_id], onDelete: Restrict, onUpdate: NoAction, map: "fk_product_modifier_groups_product_same_tenant")
  tenants           tenants         @relation(fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_product_modifier_groups_tenant")

  @@id([tenant_id, product_id, modifier_group_id])
  @@index([tenant_id], map: "idx_product_modifier_groups_tenant_id")
  @@index([product_id, tenant_id], map: "idx_product_modifier_groups_product_tenant")
  @@index([modifier_group_id, tenant_id], map: "idx_product_modifier_groups_group_tenant")
}

/// V1-M1: immutable transaction item modifier snapshot. Snapshot names and price
/// delta are authoritative historical data; master IDs are nullable provenance
/// only and must never be required for receipt correctness. Contains a CHECK
/// constraint for the non-negative price delta that Prisma cannot represent directly.
model transaction_item_modifiers {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id            String            @db.Uuid
  transaction_id       String            @db.Uuid
  transaction_item_id  String            @db.Uuid
  modifier_group_id    String?           @db.Uuid
  modifier_option_id   String?           @db.Uuid
  group_name_snapshot  String            @db.VarChar(150)
  option_name_snapshot String            @db.VarChar(150)
  price_delta_snapshot Int
  created_at           DateTime          @default(now()) @db.Timestamptz(6)
  transaction_items    transaction_items @relation(fields: [transaction_item_id, tenant_id], references: [id, tenant_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_transaction_item_modifiers_item_same_tenant")
  transactions         transactions      @relation(fields: [transaction_id, tenant_id], references: [id, tenant_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_transaction_item_modifiers_transaction_same_tenant")
  tenants              tenants           @relation(fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_transaction_item_modifiers_tenant")

  @@index([tenant_id, transaction_id], map: "idx_transaction_item_modifiers_tenant_transaction")
  @@index([tenant_id, transaction_item_id], map: "idx_transaction_item_modifiers_tenant_item")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model products {
  id                      String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id               String                    @db.Uuid
  category_id             String?                   @db.Uuid
  name                    String                    @db.VarChar(150)
  sku                     String                    @db.VarChar(100)
  price                   Int                       @default(0)
  cost                    Int                       @default(0)
  minimum_stock           Int                       @default(0)
  track_stock             Boolean                   @default(true)
  is_active               Boolean                   @default(true)
  created_at              DateTime                  @default(now()) @db.Timestamptz(6)
  product_stocks          product_stocks[]
  categories              categories?               @relation(fields: [category_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_products_category")
  tenants                 tenants                   @relation(fields: [tenant_id], references: [id], onUpdate: NoAction, map: "fk_products_tenant")
  stock_adjustments       stock_adjustments[]
  stock_movements         stock_movements[]
  transaction_items       transaction_items[]
  product_modifier_groups product_modifier_groups[]
  held_order_items        held_order_items[]

  @@unique([tenant_id, sku], map: "uq_products_tenant_sku")
  @@unique([id, tenant_id], map: "uq_products_id_tenant")
  @@index([category_id], map: "idx_products_category_id")
  @@index([tenant_id], map: "idx_products_tenant_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model stock_adjustments {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id  String   @db.Uuid
  outlet_id  String   @db.Uuid
  product_id String   @db.Uuid
  user_id    String   @db.Uuid
  type       String   @db.VarChar(10)
  quantity   Int
  reason     String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  outlets    outlets  @relation(fields: [outlet_id], references: [id], onUpdate: NoAction, map: "fk_stock_adjustments_outlet")
  products   products @relation(fields: [product_id], references: [id], onUpdate: NoAction, map: "fk_stock_adjustments_product")
  tenants    tenants  @relation(fields: [tenant_id], references: [id], onUpdate: NoAction, map: "fk_stock_adjustments_tenant")
  users      users    @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "fk_stock_adjustments_user")

  @@index([created_at], map: "idx_stock_adjustments_created_at")
  @@index([outlet_id], map: "idx_stock_adjustments_outlet_id")
  @@index([product_id], map: "idx_stock_adjustments_product_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model stock_movements {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id      String   @db.Uuid
  outlet_id      String   @db.Uuid
  product_id     String   @db.Uuid
  user_id        String   @db.Uuid
  type           String   @db.VarChar(20)
  quantity       Int
  reference_type String?  @db.VarChar(50)
  reference_id   String?  @db.Uuid
  reason         String?
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  outlets        outlets  @relation(fields: [outlet_id], references: [id], onUpdate: NoAction, map: "fk_stock_movements_outlet")
  products       products @relation(fields: [product_id], references: [id], onUpdate: NoAction, map: "fk_stock_movements_product")
  tenants        tenants  @relation(fields: [tenant_id], references: [id], onUpdate: NoAction, map: "fk_stock_movements_tenant")
  users          users    @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "fk_stock_movements_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model tenants {
  id                         String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  store_code                 String?                      @unique(map: "uq_tenants_store_code") @db.VarChar(32)
  name                       String                       @db.VarChar(100)
  address                    String?
  tax_enabled                Boolean                      @default(false)
  tax_included               Boolean                      @default(false)
  tax_rate                   Decimal                      @default(0) @db.Decimal(5, 2)
  is_active                  Boolean                      @default(true)
  created_at                 DateTime                     @default(now()) @db.Timestamptz(6)
  categories                 categories[]
  customers                  customers[]
  outlets                    outlets[]
  products                   products[]
  stock_adjustments          stock_adjustments[]
  stock_movements            stock_movements[]
  transactions               transactions[]
  users                      users[]
  transaction_items          transaction_items[]
  payments                   payments[]
  cashier_sessions           cashier_sessions[]
  device_sessions            device_sessions[]
  auth_audit_logs            auth_audit_logs[]
  modifier_groups            modifier_groups[]
  modifier_options           modifier_options[]
  product_modifier_groups    product_modifier_groups[]
  transaction_item_modifiers transaction_item_modifiers[]
  held_orders                held_orders[]
  held_order_items           held_order_items[]
  held_order_item_modifiers  held_order_item_modifiers[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// V1-M1: added snapshot fields to preserve historical product identity and
/// pricing at transaction time. Legacy rows have NULL for new fields.
model transaction_items {
  id                         String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id                  String                       @db.Uuid
  transaction_id             String                       @db.Uuid
  product_id                 String                       @db.Uuid
  quantity                   Int
  unit_price                 BigInt
  unit_cost                  BigInt
  subtotal                   BigInt
  product_name_snapshot      String?                      @db.VarChar(150)
  sku_snapshot               String?                      @db.VarChar(100)
  base_price_snapshot        BigInt?
  effective_price_snapshot   BigInt?
  note_snapshot              String?                      @db.VarChar(255)
  created_at                 DateTime                     @default(now()) @db.Timestamptz(6)
  products                   products                     @relation(fields: [product_id, tenant_id], references: [id, tenant_id], onUpdate: NoAction, map: "fk_transaction_items_product_same_tenant")
  transactions               transactions                 @relation(fields: [transaction_id, tenant_id], references: [id, tenant_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_transaction_items_transaction_same_tenant")
  tenants                    tenants                      @relation(fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_transaction_items_tenant")
  transaction_item_modifiers transaction_item_modifiers[]

  @@unique([id, tenant_id], map: "uq_transaction_items_id_tenant")
  @@index([product_id], map: "idx_transaction_items_product_id")
  @@index([transaction_id], map: "idx_transaction_items_transaction_id")
  @@index([tenant_id, transaction_id], map: "idx_transaction_items_tenant_transaction")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model transactions {
  id                         String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id                  String                       @db.Uuid
  outlet_id                  String                       @db.Uuid
  user_id                    String                       @db.Uuid
  customer_id                String?                      @db.Uuid
  cashier_session_id         String?                      @db.Uuid
  client_transaction_id      String                       @db.Uuid
  status                     String                       @default("PENDING") @db.VarChar(20)
  subtotal                   BigInt                       @default(0)
  discount                   BigInt                       @default(0)
  tax                        BigInt                       @default(0)
  total                      BigInt                       @default(0)
  created_at                 DateTime                     @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime                     @default(now()) @updatedAt @db.Timestamptz(6)
  payments                   payments[]
  transaction_items          transaction_items[]
  transaction_item_modifiers transaction_item_modifiers[]
  converted_held_orders      held_orders[]
  cashier_sessions           cashier_sessions?            @relation(fields: [cashier_session_id, tenant_id], references: [id, tenant_id], onDelete: Restrict, onUpdate: NoAction, map: "fk_transactions_cashier_session_same_tenant")
  customers                  customers?                   @relation(fields: [customer_id, tenant_id], references: [id, tenant_id], onDelete: Restrict, onUpdate: NoAction, map: "fk_transactions_customer_same_tenant")
  outlets                    outlets                      @relation(fields: [outlet_id, tenant_id], references: [id, tenant_id], onUpdate: NoAction, map: "fk_transactions_outlet_same_tenant")
  tenants                    tenants                      @relation(fields: [tenant_id], references: [id], onUpdate: NoAction, map: "fk_transactions_tenant")
  users                      users                        @relation(fields: [user_id, tenant_id], references: [id, tenant_id], onUpdate: NoAction, map: "fk_transactions_user_same_tenant")

  @@unique([tenant_id, client_transaction_id], map: "uq_transactions_client_id")
  @@unique([id, tenant_id], map: "uq_transactions_id_tenant")
  @@index([outlet_id, created_at], map: "idx_transactions_outlet_created_at")
  @@index([outlet_id], map: "idx_transactions_outlet_id")
  @@index([tenant_id], map: "idx_transactions_tenant_id")
  @@index([user_id], map: "idx_transactions_user_id")
  @@index([tenant_id, cashier_session_id], map: "idx_transactions_tenant_cashier_session")
  @@index([tenant_id, created_at], map: "idx_transactions_tenant_created_at")
  @@index([tenant_id, status], map: "idx_transactions_tenant_status")
  @@index([tenant_id, customer_id, created_at], map: "idx_transactions_tenant_customer_created_at")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id           String              @db.Uuid
  outlet_id           String?             @db.Uuid
  name                String              @db.VarChar(100)
  email               String              @db.VarChar(255)
  password_hash       String
  pin_hash            String?
  login_code          String?             @db.VarChar(50)
  pin_failed_attempts Int                 @default(0)
  locked_until        DateTime?           @db.Timestamptz(6)
  pin_changed_at      DateTime?           @db.Timestamptz(6)
  role                String              @db.VarChar(20)
  is_active           Boolean             @default(true)
  created_at          DateTime            @default(now()) @db.Timestamptz(6)
  updated_at          DateTime            @default(now()) @updatedAt @db.Timestamptz(6)
  stock_adjustments   stock_adjustments[]
  stock_movements     stock_movements[]
  transactions        transactions[]
  cashier_sessions    cashier_sessions[]
  device_sessions     device_sessions[]
  auth_audit_logs     auth_audit_logs[]
  held_orders         held_orders[]
  outlets             outlets?            @relation(fields: [outlet_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_users_outlet")
  tenants             tenants             @relation(fields: [tenant_id], references: [id], onUpdate: NoAction, map: "fk_users_tenant")

  @@unique([tenant_id, email], map: "uq_users_tenant_email")
  @@unique([tenant_id, login_code], map: "uq_users_tenant_login_code")
  @@unique([id, tenant_id], map: "uq_users_id_tenant")
  @@index([tenant_id], map: "idx_users_tenant_id")
}

/**
 * Held Order (Open Bill) domain.
 * V1-M7: Authoritative draft orders before checkout.
 * Enforced tenant/outlet/cashier-session isolation via composite FKs and @@unique.
 * Optimistic concurrency via integer version field.
 * Server-authoritative pricing snapshots; modifier IDs are never serialized as JSON.
 */

model held_orders {
  id                        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id                 String    @db.Uuid
  outlet_id                 String    @db.Uuid
  origin_cashier_session_id String    @db.Uuid
  cashier_user_id           String    @db.Uuid
  label                     String?   @db.VarChar(100)
  status                    String    @default("OPEN") @db.VarChar(20)
  version                   Int       @default(1)
  subtotal_estimate         BigInt    @default(0)
  tax_estimate              BigInt    @default(0)
  total_estimate            BigInt    @default(0)
  converted_transaction_id  String?   @db.Uuid
  created_at                DateTime  @default(now()) @db.Timestamptz(6)
  updated_at                DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  cancelled_at              DateTime? @db.Timestamptz(6)
  converted_at              DateTime? @db.Timestamptz(6)

  tenants          tenants            @relation(fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_held_orders_tenant")
  outlets          outlets            @relation(fields: [outlet_id, tenant_id], references: [id, tenant_id], onDelete: Restrict, onUpdate: NoAction, map: "fk_held_orders_outlet_same_tenant")
  cashier_sessions cashier_sessions   @relation(fields: [origin_cashier_session_id, tenant_id], references: [id, tenant_id], onDelete: Restrict, onUpdate: NoAction, map: "fk_held_orders_cashier_session_same_tenant")
  users            users              @relation(fields: [cashier_user_id, tenant_id], references: [id, tenant_id], onDelete: Restrict, onUpdate: NoAction, map: "fk_held_orders_user_same_tenant")
  transactions     transactions?      @relation(fields: [converted_transaction_id, tenant_id], references: [id, tenant_id], onDelete: Restrict, onUpdate: NoAction, map: "fk_held_orders_converted_transaction_same_tenant")
  held_order_items held_order_items[]

  @@unique([id, tenant_id], map: "uq_held_orders_id_tenant")
  @@index([tenant_id], map: "idx_held_orders_tenant_id")
  @@index([tenant_id, outlet_id], map: "idx_held_orders_tenant_outlet")
  @@index([tenant_id, origin_cashier_session_id], map: "idx_held_orders_tenant_session")
  @@index([tenant_id, cashier_user_id], map: "idx_held_orders_tenant_cashier")
  @@index([tenant_id, status], map: "idx_held_orders_tenant_status")
  @@index([tenant_id, created_at], map: "idx_held_orders_tenant_created_at")
  @@map("held_orders")
}

model held_order_items {
  id                       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id                String   @db.Uuid
  held_order_id            String   @db.Uuid
  product_id               String   @db.Uuid
  quantity                 Int
  product_name_snapshot    String   @db.VarChar(150)
  sku_snapshot             String   @db.VarChar(100)
  base_price_snapshot      BigInt
  effective_price_snapshot BigInt
  line_subtotal            BigInt
  line_discount            BigInt   @default(0)
  line_total               BigInt
  note_snapshot            String?  @db.VarChar(255)
  display_order            Int
  created_at               DateTime @default(now()) @db.Timestamptz(6)

  tenants                   tenants                     @relation(fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_held_order_items_tenant")
  held_orders               held_orders                 @relation(fields: [held_order_id, tenant_id], references: [id, tenant_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_held_order_items_order_same_tenant")
  products                  products                    @relation(fields: [product_id, tenant_id], references: [id, tenant_id], onDelete: Restrict, onUpdate: NoAction, map: "fk_held_order_items_product_same_tenant")
  held_order_item_modifiers held_order_item_modifiers[]

  @@unique([id, tenant_id], map: "uq_held_order_items_id_tenant")
  @@index([tenant_id, held_order_id], map: "idx_held_order_items_tenant_order")
  @@index([product_id], map: "idx_held_order_items_product_id")
  @@map("held_order_items")
}

model held_order_item_modifiers {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id            String   @db.Uuid
  held_order_item_id   String   @db.Uuid
  modifier_group_id    String?  @db.Uuid
  modifier_option_id   String?  @db.Uuid
  group_name_snapshot  String   @db.VarChar(150)
  option_name_snapshot String   @db.VarChar(150)
  price_delta_snapshot Int
  created_at           DateTime @default(now()) @db.Timestamptz(6)

  tenants          tenants          @relation(fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_held_order_item_modifiers_tenant")
  held_order_items held_order_items @relation(fields: [held_order_item_id, tenant_id], references: [id, tenant_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_held_order_item_modifiers_item_same_tenant")

  @@unique([id, tenant_id], map: "uq_held_order_item_modifiers_id_tenant")
  @@index([tenant_id, held_order_item_id], map: "idx_held_order_item_modifiers_tenant_item")
  @@map("held_order_item_modifiers")
}
