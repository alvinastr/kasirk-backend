{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "incremental": false,
    "declaration": false,
    "types": ["node", "jest"]
  },
  "include": [
    "../src/**/*.ts",
    "./**/*.ts"
  ],
  "exclude": [
    "../dist",
    "../node_modules"
  ]
}
