# Copy to .env.production on the VPS and fill values there.
# Do not commit .env.production.

# PostgreSQL container bootstrap secret
POSTGRES_PASSWORD=<set-in-production>

# Application database connection string
DATABASE_URL=postgresql://kasir:<same-password>@postgres:5432/kasirkita?schema=public

# Application JWT signing secret
JWT_SECRET=<set-in-production>

# Non-secret runtime settings
PORT=3000
NODE_ENV=production
ENABLE_SWAGGER_DOCS=false

# ============================================================
# PRODUCTION BOOTSTRAP (one-time initial business data setup)
# ============================================================
# Run once against an EMPTY migrated production database.
# DO NOT use for development or re-run once business data exists.
#
# Required environment variables for bootstrap:
# BOOTSTRAP_STORE_CODE        - Store code: ^[A-Z0-9-]{3,32}$
# BOOTSTRAP_TENANT_NAME       - Tenant name (non-empty, max 100 chars)
# BOOTSTRAP_TENANT_ADDRESS    - (optional) Tenant address
# BOOTSTRAP_OUTLET_NAME       - Outlet name (non-empty, max 100 chars)
# BOOTSTRAP_OUTLET_ADDRESS    - (optional) Outlet address
# BOOTSTRAP_OWNER_NAME        - OWNER name (non-empty, max 150 chars)
# BOOTSTRAP_OWNER_EMAIL       - OWNER email (valid format, max 255 chars)
# BOOTSTRAP_OWNER_PASSWORD    - OWNER password (non-empty, bcrypt 72-byte limit)
# BOOTSTRAP_OWNER_PIN         - OWNER PIN (exactly 6 ASCII digits)
#
# Example (run inside app container, secrets passed via runtime env only):
#   docker compose --env-file .env.production run --rm app sh -c "BOOTSTRAP_STORE_CODE='KAS-001' \
#     BOOTSTRAP_TENANT_NAME='KasirKita' \
#     BOOTSTRAP_OUTLET_NAME='Main Outlet' \
#     BOOTSTRAP_OWNER_NAME='Initial Owner' \
#     BOOTSTRAP_OWNER_EMAIL='admin@example.com' \
#     BOOTSTRAP_OWNER_PASSWORD='**REDACTED**' \
#     BOOTSTRAP_OWNER_PIN='123456' \
#     npm run bootstrap:production"
#
# DO NOT store these values in git or logs. Use runtime-only env injection.
